{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.carlosphyll/phyll",
  "title": "Phyll",
  "description": "UX review for apps built with AI, run by your own agent. The fixes keep your design.",
  "websiteUrl": "https://agentphyll.com",
  "repository": {
    "url": "https://github.com/carlosphyll/phyll",
    "source": "github",
    "subfolder": "packages/connector"
  },
  "version": "0.4.6",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "phyll",
      "version": "0.4.6",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
